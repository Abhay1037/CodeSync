# ---- Server configuration ----
# Port the Express + Socket.io server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

# ---- Code execution (Piston) ----
# Public Piston API by default; self-host and point this at your instance in prod.
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_TIMEOUT_MS=10000
# Optional bearer token (required by the public API in some deployments).
PISTON_API_KEY=
# Run code as a child process of THIS server when Piston is unreachable?
# Development only - there is no sandbox. Defaults to true unless NODE_ENV=production.
# ALLOW_LOCAL_EXEC=true

# ---- Persistence + auth ----
# Local MongoDB by default; use a MongoDB Atlas URI in production.
# IMPORTANT: URL-encode special characters in the password (@ -> %40).
MONGO_URI=mongodb://127.0.0.1:27017/codesync
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codesync
# CHANGE THIS in production (use a long random string).
JWT_SECRET=codesync-dev-secret-change-me
JWT_EXPIRES_IN=7d
# Debounce window for saving room code to the database (ms).
PERSIST_DEBOUNCE_MS=1200
# Idle rooms older than this many days are pruned from MongoDB (0 = keep forever).
ROOM_TTL_DAYS=30

# ---- Production hardening ----
# Express serves client/dist automatically in production when it exists.
# Override only if the build output lives somewhere else.
# CLIENT_DIST_PATH=/absolute/path/to/client/dist
# Per-IP fixed-window limits for the public endpoints (ms / request counts).
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
EXECUTE_RATE_LIMIT_MAX=60
